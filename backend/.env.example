PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ugee_mock_portal
NODE_ENV=development
# 32+ random characters (production boot fails otherwise). e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Session cookie lifetime in hours (sliding renewal while active). Default 24.
SESSION_TTL_HOURS=24
# Public https origin of the portal, used in email links and OAuth callbacks.
PORTAL_BASE_URL=https://mock.aceiiit.in
# Shared secret for server-to-server provisioning from the AceIIIT commerce backend (32+ chars).
INTERNAL_API_SECRET=replace-with-32-plus-char-random-secret
# 32+ char key used to encrypt Google Calendar refresh tokens at rest.
CALENDAR_TOKEN_KEY=replace-with-32-plus-char-random-key
# DEVELOPMENT ONLY: accept mock_google_/mock_apple_ logins. Refused when NODE_ENV=production.
ALLOW_INSECURE_DEV_AUTH=false

# OAuth (Google required in production; Apple sign-in is disabled unless APPLE_CLIENT_ID is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
ADMIN_EMAILS=admin1@example.com,admin2@example.com
REQUEST_TIMEOUT_MS=15000
SERVER_REQUEST_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# Email: Resend (primary) → Brevo (fallback) → SMTP (only if configured).
# Production needs at least one of RESEND_API_KEY / BREVO_API_KEY.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=ACE IIIT <noreply@aceiiit.in>
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ACE IIIT
# Optional sender for reminder/calendar emails (defaults to RESEND_FROM).
REMINDER_FROM_EMAIL=
# Optional SMTP last-resort fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Commerce provisioning: resource codes that map to the current active season when no
# season is explicitly tagged with that resourceCode.
COMMERCE_ACTIVE_SEASON_RESOURCE_CODES=PAID_MOCK_SERIES

# CORS (only needed if serving frontend separately)
CORS_ORIGIN=

# Mongo tuning
# Production runs with autoIndex off. Create new indexes with
# `node scripts/migrations/2026-10-sync-indexes.js --apply` (boot logs a warning if any are missing).
MONGO_AUTO_INDEX=false
MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=3
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=15000
MONGO_CONNECT_TIMEOUT_MS=5000
DB_RETRY_DELAY_MS=5000

# Attempt queue smoothing
ATTEMPT_QUEUE_CONCURRENCY=8
ATTEMPT_QUEUE_MAX_SIZE=180
ATTEMPT_QUEUE_MAX_WAIT_MS=20000
UPLOAD_REQUEST_TIMEOUT_MS=45000

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# Or set a single variable:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Performance Intelligence (Gemini). Off by default; deterministic analytics always work.
# Keep the key server-side only. Free-tier content may be used by Google to improve its
# products, so the portal sends only aggregate evidence (no names, emails or question text).
AI_INTERPRETATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=20000
# Circuit breaker on quota exhaustion (provider retryDelay wins when given)
AI_BREAKER_TTL_MS=3600000
AI_BREAKER_MAX_MS=86400000
# Minimum gap between Gemini calls from the worker (free-tier rate limits)
AI_MIN_INTERVAL_MS=4000

# Observability
LOG_LEVEL=info
# Optional error monitoring (no request bodies or cookies are sent)
SENTRY_DSN=
SHUTDOWN_TIMEOUT_MS=10000
# Password hashing runs on the libuv threadpool: set to the host's vCPU count (minimum 4).
UV_THREADPOOL_SIZE=4

# Background job intervals (defaults shown)
ATTEMPT_SWEEP_INTERVAL_MS=30000
AI_WORKER_INTERVAL_MS=5000
REMINDER_SCAN_INTERVAL_SECONDS=60
