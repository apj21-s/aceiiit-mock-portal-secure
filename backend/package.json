{
  "name": "ugee-mock-platform-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "seed": "node scripts/seed-ugee-2026.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "node tests/e2e/production.e2e.js && node tests/e2e/exam.e2e.js && node tests/e2e/admin.e2e.js && node tests/e2e/responsive.e2e.js && node tests/e2e/mobile-flows.e2e.js",
    "load-test": "node scripts/load-test.js"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@sentry/node": "^11.4.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^180.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.19.0",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.9.9",
    "puppeteer-core": "^23.11.1",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/helpers/env.js"
    ]
  }
}
